{
  "color": {
    "dark": {
      "canvas": { "$value": "#0f1115", "$type": "color" },
      "panel": { "$value": "#14161a", "$type": "color" },
      "surface": { "$value": "#1e2128", "$type": "color" },
      "surface-raised": { "$value": "#252830", "$type": "color" },
      "border": { "$value": "#3a3f47", "$type": "color" },
      "border-strong": { "$value": "#252a33", "$type": "color" },
      "text": { "$value": "#e6e8eb", "$type": "color" },
      "text-body": { "$value": "#d7dbe0", "$type": "color" },
      "text-muted": { "$value": "#9aa0a6", "$type": "color" },
      "primary": { "$value": "#2f6feb", "$type": "color" },
      "primary-hover": { "$value": "#2559c4", "$type": "color" },
      "accent": { "$value": "#6ba3ff", "$type": "color" },
      "warning-bg": { "$value": "#3d2a14", "$type": "color" },
      "warning-text": { "$value": "#f0c674", "$type": "color" },
      "danger-bg": { "$value": "#3d1e1e", "$type": "color" },
      "danger-text": { "$value": "#f48771", "$type": "color" },
      "success-text": { "$value": "#3fb950", "$type": "color" }
    },
    "light": {
      "canvas": { "$value": "#ffffff", "$type": "color" },
      "panel": { "$value": "#f6f7f9", "$type": "color" },
      "surface": { "$value": "#eef0f3", "$type": "color" },
      "border": { "$value": "#e2e4e8", "$type": "color" },
      "border-strong": { "$value": "#dadce0", "$type": "color" },
      "text": { "$value": "#1a1d21", "$type": "color" },
      "text-muted": { "$value": "#5f6368", "$type": "color" },
      "primary": { "$value": "#1a73e8", "$type": "color" },
      "danger-text": { "$value": "#c5221f", "$type": "color" }
    }
  },
  "typography": {
    "h1": {
      "$type": "typography",
      "$value": {
        "fontFamily": "system-ui, -apple-system, Segoe UI, sans-serif",
        "fontSize": "28px",
        "fontWeight": 600,
        "lineHeight": 1.2
      }
    },
    "body-md": {
      "$type": "typography",
      "$value": {
        "fontFamily": "system-ui, -apple-system, Segoe UI, sans-serif",
        "fontSize": "13px",
        "fontWeight": 400,
        "lineHeight": 1.55
      }
    },
    "body-sm": {
      "$type": "typography",
      "$value": {
        "fontFamily": "system-ui, -apple-system, Segoe UI, sans-serif",
        "fontSize": "12px",
        "fontWeight": 400,
        "lineHeight": 1.5
      }
    },
    "label": {
      "$type": "typography",
      "$value": {
        "fontFamily": "system-ui, -apple-system, Segoe UI, sans-serif",
        "fontSize": "11px",
        "fontWeight": 500,
        "lineHeight": 1.4
      }
    },
    "code": {
      "$type": "typography",
      "$value": {
        "fontFamily": "ui-monospace, SFMono-Regular, Menlo, monospace",
        "fontSize": "12.5px",
        "fontWeight": 400,
        "lineHeight": 1.5
      }
    }
  },
  "spacing": {
    "xs": { "$value": "4px", "$type": "dimension" },
    "sm": { "$value": "8px", "$type": "dimension" },
    "md": { "$value": "12px", "$type": "dimension" },
    "lg": { "$value": "16px", "$type": "dimension" },
    "xl": { "$value": "24px", "$type": "dimension" }
  },
  "rounded": {
    "sm": { "$value": "4px", "$type": "dimension" },
    "md": { "$value": "6px", "$type": "dimension" }
  }
}
